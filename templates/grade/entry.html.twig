{% extends 'layout/app.html.twig' %}
{% import 'components/_icons.html.twig' as ic %}

{% set crumbs = [
  {label: 'Inicio', route: path('app_dashboard')},
  {label: 'Evaluación'},
  {label: 'Ingreso de notas', route: path('app_grade_entry')},
  {label: vm.fullName}
] %}

{% block title %}Notas · {{ vm.fullName }}{% endblock %}

{% block body %}
{% set carryRows = previousRows|merge(otherRows) %}
{% set isOpen = selectedEnrollment and selectedEnrollment.periodStatus == 'ABIERTO' %}
{% set canSave = summary.editable > 0 and isOpen %}

<div class="va-page ge-page">

  <header class="page-header page-header--hero ge-hero">
    <div class="page-header__main">
      <p class="ge-eyebrow">Evaluación</p>
      <h1>Ingreso de notas</h1>
      <p class="subtitle">Registra calificaciones únicamente dentro de una inscripción académica válida.</p>
      <blockquote class="page-header__quote">“Cada nota debe quedar asociada al período correcto.”</blockquote>
    </div>

    <div class="ge-hero__actions">
      <a class="btn btn--secondary" href="{{ path('app_grade_entry') }}">
        {{ ic.glyph('arrowLeft', 16) }}<span>Cambiar estudiante</span>
      </a>
      {% if not teacherMode|default(false) %}
        <a class="btn btn--secondary" href="{{ path('app_transcript_show', {id: vm.id}) }}">
          {{ ic.glyph('file', 16) }}<span>Ver expediente</span>
        </a>
      {% endif %}
    </div>
  </header>

  <section class="card ge-context" aria-label="Contexto de calificación">
    <div class="ge-context__student">
      <span class="avatar ge-context__avatar">
        {% if vm.photoPath and vm.photoPath starts with '/uploads/students/' %}
          <img src="{{ vm.photoPath }}" alt="Fotografía de {{ vm.fullName }}">
        {% else %}
          <span aria-hidden="true">{{ vm.firstNames|slice(0,1) ~ vm.lastNames|slice(0,1) }}</span>
        {% endif %}
      </span>
      <div>
        <p class="ge-context__label">Estudiante</p>
        <h2>{{ vm.fullName }}</h2>
        <p>{{ vm.code }}</p>
        <small>{{ vm.career }} · {{ vm.curriculum }}</small>
      </div>
    </div>

    {% if selectedEnrollment %}
      <div class="ge-context__period">
        <div class="ge-context__period-head">
          <span class="ge-context__period-icon">{{ ic.glyph('calendar', 18) }}</span>
          <div>
            <p class="ge-context__label">Inscripción seleccionada</p>
            <h3>{{ selectedEnrollment.periodLabel }}</h3>
            <small>{{ selectedEnrollment.cycle }} · Sección {{ selectedEnrollment.section }}</small>
          </div>
        </div>
        <div class="ge-context__period-badges">
          {% include 'components/_status_badge.html.twig' with {status: selectedEnrollment.periodStatus} %}
          {% include 'components/_status_badge.html.twig' with {status: selectedEnrollment.enrollmentStatus} %}
        </div>
      </div>

      <form class="ge-context__selector" method="get" action="{{ path('app_grade_entry') }}">
        <input type="hidden" name="student" value="{{ vm.id }}">
        <div class="field">
          <label for="enrollment">Cambiar período / inscripción</label>
          <select id="enrollment" name="enrollment" onchange="this.form.submit()">
            {% for enrollment in enrollments %}
              <option value="{{ enrollment.enrollmentId }}" {% if enrollment.enrollmentId == selectedEnrollment.enrollmentId %}selected{% endif %}>
                {{ enrollment.periodLabel }} · {{ enrollment.cycle }} · Sección {{ enrollment.section }} · {{ status_label(enrollment.enrollmentStatus) }}
              </option>
            {% endfor %}
          </select>
        </div>
        <noscript><button class="btn btn--secondary" type="submit">Cambiar</button></noscript>
      </form>
    {% endif %}
  </section>

  {% if not selectedEnrollment %}
    <section class="card ge-no-enrollment">
      {% include 'components/_empty_state.html.twig' with {
        title: 'Sin inscripción académica',
        message: 'El estudiante tiene ficha y programa, pero todavía no posee una inscripción a un período. No hay notas que registrar.'
      } %}
      <div class="ge-no-enrollment__actions">
        {% if not teacherMode|default(false) %}
          <a class="btn btn--secondary" href="{{ path('app_student_show', {id: vm.id}) }}">Ver perfil</a>
        {% endif %}
        <a class="btn btn--primary" href="{{ path('app_grade_entry') }}">Seleccionar otro estudiante</a>
      </div>
    </section>
  {% else %}

    {% if not isOpen %}
      <div class="notice notice--warning ge-period-warning" role="status">
        {{ ic.glyph('lock', 17) }}
        <div>
          <strong>Período cerrado para edición</strong>
          <p>Las calificaciones se muestran como consulta. La base de datos bloquea cambios fuera de períodos ABIERTOS.</p>
        </div>
      </div>
    {% elseif selectedEnrollment.enrollmentStatus != 'INSCRITO' %}
      <div class="notice notice--warning ge-period-warning" role="status">
        {{ ic.glyph('alert', 17) }}
        <div>
          <strong>Inscripción no habilitada para calificar</strong>
          <p>El estado actual es {{ status_label(selectedEnrollment.enrollmentStatus) }}. Las filas reflejan los bloqueos definidos por la vista académica.</p>
        </div>
      </div>
    {% endif %}

    <div class="grid-metrics ge-metrics">
      {% include 'components/_metric_card.html.twig' with {
        icon: ic.glyph('book', 22),
        tone: 'terracotta',
        label: 'Cursos visibles',
        value: summary.rows,
        caption: 'en la inscripción seleccionada'
      } %}
      {% include 'components/_metric_card.html.twig' with {
        icon: ic.glyph('pencil', 22),
        tone: 'success',
        label: 'Editables',
        value: summary.editable,
        caption: 'permitidos por las reglas'
      } %}
      {% include 'components/_metric_card.html.twig' with {
        icon: ic.glyph('check', 22),
        tone: 'success',
        label: 'Con nota',
        value: summary.graded,
        caption: 'resultados registrados'
      } %}
      {% include 'components/_metric_card.html.twig' with {
        icon: ic.glyph('lock', 22),
        tone: 'warning',
        label: 'Bloqueados',
        value: summary.blocked,
        caption: 'sin edición disponible'
      } %}
    </div>

    <form method="post" action="{{ path('app_grade_entry', {student: vm.id, enrollment: selectedEnrollment.enrollmentId}) }}" data-controller="dirty-form" class="ge-form">
      <input type="hidden" name="_token" value="{{ csrf_token('app_grade_entry') }}">

      {% if formErrors is defined and formErrors|length %}
        <div class="notice notice--danger ge-errors" role="alert">
          <strong>No se guardaron las notas:</strong>
          <ul>{% for error in formErrors %}<li>{{ error }}</li>{% endfor %}</ul>
        </div>
      {% endif %}

      <section class="card ge-grade-section">
        <header class="ge-grade-section__head">
          <div>
            <p class="ge-eyebrow">Ciclo de la inscripción</p>
            <h2>Cursos del ciclo actual</h2>
            <p>{{ currentRows|length }} curso{{ currentRows|length == 1 ? '' : 's' }} esperado{{ currentRows|length == 1 ? '' : 's' }} según el pensum y ciclo seleccionado.</p>
          </div>
        </header>

        <div class="table-wrap ge-grade-table">
          <table class="data">
            <thead>
              <tr>
                <th scope="col">Código</th>
                <th scope="col">Curso</th>
                <th scope="col">Tipo</th>
                <th scope="col">Oferta</th>
                <th scope="col">Nota</th>
                <th scope="col">Estado</th>
                <th scope="col">Condición</th>
              </tr>
            </thead>
            <tbody>
              {% for row in currentRows %}
                <tr class="{{ row.editable ? 'is-editable' : 'is-locked' }}">
                  <td><span class="ge-course-code">{{ row.courseCode }}</span></td>
                  <td><strong>{{ row.courseName }}</strong></td>
                  <td>{% include 'components/_status_badge.html.twig' with {status: row.required} %}</td>
                  <td>
                    {% if row.offeringId %}
                      <span class="ge-offer">{{ row.offeringActive ? 'Activa' : 'Inactiva' }}</span>
                    {% else %}
                      <span class="ge-muted">Sin oferta</span>
                    {% endif %}
                  </td>
                  <td>
                    {% if row.editable %}
                      {% set value = posted[row.offeringId] is defined ? posted[row.offeringId] : row.grade %}
                      <input class="ge-grade-input" type="number" min="0" max="100" step="0.01" name="grades[{{ row.offeringId }}]" value="{{ value ?? '' }}" aria-label="Nota de {{ row.courseName }}">
                    {% else %}
                      <span class="ge-grade-readonly">{{ row.grade is not null ? row.grade|number_format(2, '.', '') : '—' }}</span>
                    {% endif %}
                  </td>
                  <td>{% include 'components/_status_badge.html.twig' with {status: row.status, label: row.statusLabel} %}</td>
                  <td>
                    {% if row.editable %}
                      <span class="ge-condition ge-condition--ok">{{ ic.glyph('check', 13) }} Editable</span>
                    {% else %}
                      <span class="ge-condition ge-condition--locked">{{ ic.glyph('lock', 13) }} {{ row.blockMessage|default('Bloqueado') }}</span>
                    {% endif %}
                  </td>
                </tr>
              {% else %}
                <tr>
                  <td colspan="7">
                    {% include 'components/_empty_state.html.twig' with {
                      title: 'Sin cursos del ciclo actual',
                      message: 'La inscripción seleccionada no tiene cursos esperados para este ciclo.'
                    } %}
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </section>

      <section class="card ge-grade-section">
        <header class="ge-grade-section__head">
          <div>
            <p class="ge-eyebrow">Arrastres y otros ciclos</p>
            <h2>Cursos fuera del ciclo actual</h2>
            <p>Solo aparecen cuando la vista académica identifica un intento previo, una repitencia o un curso de otro ciclo.</p>
          </div>
          <span class="chip">{{ carryRows|length }} curso{{ carryRows|length == 1 ? '' : 's' }}</span>
        </header>

        <div class="table-wrap ge-grade-table">
          <table class="data">
            <thead>
              <tr>
                <th scope="col">Código</th>
                <th scope="col">Curso</th>
                <th scope="col">Origen</th>
                <th scope="col">Ciclo curricular</th>
                <th scope="col">Nota</th>
                <th scope="col">Estado</th>
                <th scope="col">Condición</th>
              </tr>
            </thead>
            <tbody>
              {% for row in carryRows %}
                <tr class="{{ row.editable ? 'is-editable' : 'is-locked' }}">
                  <td><span class="ge-course-code">{{ row.courseCode }}</span></td>
                  <td><strong>{{ row.courseName }}</strong></td>
                  <td><span class="chip">{{ row.originLabel }}</span></td>
                  <td>{{ row.originalCycle }}</td>
                  <td>
                    {% if row.editable %}
                      {% set value = posted[row.offeringId] is defined ? posted[row.offeringId] : row.grade %}
                      <input class="ge-grade-input" type="number" min="0" max="100" step="0.01" name="grades[{{ row.offeringId }}]" value="{{ value ?? '' }}" aria-label="Nota de {{ row.courseName }}">
                    {% else %}
                      <span class="ge-grade-readonly">{{ row.grade is not null ? row.grade|number_format(2, '.', '') : '—' }}</span>
                    {% endif %}
                  </td>
                  <td>{% include 'components/_status_badge.html.twig' with {status: row.status, label: row.statusLabel} %}</td>
                  <td>
                    {% if row.editable %}
                      <span class="ge-condition ge-condition--ok">{{ ic.glyph('check', 13) }} Editable</span>
                    {% else %}
                      <span class="ge-condition ge-condition--locked">{{ ic.glyph('lock', 13) }} {{ row.blockMessage|default('Bloqueado') }}</span>
                    {% endif %}
                  </td>
                </tr>
              {% else %}
                <tr>
                  <td colspan="7">
                    {% include 'components/_empty_state.html.twig' with {
                      title: 'Sin cursos pendientes de otros ciclos',
                      message: 'No existen repitencias ni cursos de otros ciclos asociados a esta inscripción.'
                    } %}
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </section>

      <section class="ge-savebar">
        <div class="ge-savebar__rules">
          <span class="ge-savebar__icon">{{ ic.glyph('info', 18) }}</span>
          <div>
            <strong>Reglas aplicadas por PostgreSQL</strong>
            <p>Período abierto, inscripción válida, oferta activa y bloqueo de nuevos intentos tras aprobación. La UI no calcula la nota mínima de aprobación.</p>
          </div>
        </div>

        <div class="ge-savebar__actions">
          <a class="btn btn--secondary" href="{{ path('app_grade_entry', {student: vm.id, enrollment: selectedEnrollment.enrollmentId}) }}">Descartar cambios</a>
          <button class="btn btn--primary" type="submit" {% if not canSave %}disabled{% endif %}>
            {{ ic.glyph('check', 16) }}<span>Guardar notas</span>
          </button>
        </div>
      </section>
    </form>
  {% endif %}
</div>
{% endblock %}
