{% extends 'layout/app.html.twig' %}
{% import 'components/_icons.html.twig' as ic %}
{% set crumbs = [{label:'Inicio'}] %}
{% block title %}Panel directivo · Sistema Académico{% endblock %}
{% block body %}
<div class="va-page va-page--dashboard">
  <section class="hero-editorial va-hero">
    <div class="hero-editorial__eyebrow">DIRECCIÓN ACADÉMICA</div>
    <h1>Panel directivo</h1>
    <div class="va-hero__row">
      <div class="va-hero__period">
        <div class="va-hero__label">Período académico</div>
        <p class="hero-editorial__period">{{ vm.period.year ?? '—' }} · Semestre {{ vm.period.term == 'I' ? 'I' : 'II' }}</p>
      </div>
      <blockquote class="hero-editorial__quote">“Lectura institucional para orientar decisiones académicas.”</blockquote>
    </div>
    <hr class="va-hero__rule">
    <p class="va-hero__lead">Indicadores institucionales y seguimiento académico en modo de consulta.</p>
  </section>

  <div class="grid-metrics va-kpis">
    {% include 'components/_metric_card.html.twig' with {icon: ic.glyph('users',26), tone:'success', label:'Estudiantes activos', value:vm.activeStudents, caption:'Matrícula activa institucional'} %}
    {% include 'components/_metric_card.html.twig' with {icon: ic.glyph('check',26), tone:'success', label:'Aprobación', value:vm.approvalOnGraded, suffix:'%', progress:vm.approvalOnGraded, caption:'Sobre intentos calificados'} %}
    {% include 'components/_metric_card.html.twig' with {icon: ic.glyph('file',26), tone:'terracotta', label:'Cobertura de calificación', value:vm.gradedPercentage, suffix:'%', progress:vm.gradedPercentage} %}
    {% include 'components/_metric_card.html.twig' with {icon: ic.glyph('clock',26), tone:'warning', label:'Pendientes', value:vm.pendingGrades, caption:'Resultados pendientes'} %}
  </div>

  <div class="va-duo">
    <section class="card va-panel">
      <div class="va-panel__head"><h2 class="va-panel__title">{{ ic.glyph('pie',20) }}<span>Distribución por carrera</span></h2></div>
      <div class="va-donut-row">
        <div class="donut" role="img" aria-label="Distribución por carrera" style="background:conic-gradient({{ vm.donutCss }})">
          <div class="donut__hole"><strong>{{ vm.activeStudents }}</strong><span>estudiantes</span></div>
        </div>
        <table class="va-legend">
          {% for d in vm.donut %}
            <tr><td><span class="dot" style="background:{{ d.color }}"></span> {{ d.label }}</td><td class="va-legend__value"><strong>{{ d.value }}</strong></td><td class="va-legend__pct">{{ d.pct }} %</td></tr>
          {% endfor %}
        </table>
      </div>
    </section>

    <section class="card va-panel">
      <div class="va-panel__head"><h2 class="va-panel__title">{{ ic.glyph('trend',20) }}<span>Avance promedio por carrera</span></h2></div>
      {% for c in vm.careerProgress %}
        <div class="va-avg-row">
          <span class="va-avg-row__label">{{ c.career }}</span>
          <div class="progress va-avg-row__bar"><span class="progress__bar" style="width:{{ c.percentage }}%;background:var(--success)"></span></div>
          <strong class="va-avg-row__value">{{ c.percentage }} %</strong>
        </div>
      {% else %}<p class="va-panel__caption">Sin datos de avance.</p>{% endfor %}
    </section>
  </div>

  <div class="va-duo">
    <section class="card va-panel">
      <div class="va-panel__head">
        <h2 class="va-panel__title">{{ ic.glyph('megaphone',20) }}<span>Atención académica</span></h2>
        <a class="va-link" href="{{ path('app_report_pending_repeats') }}">Abrir seguimiento {{ ic.glyph('arrowRight',14) }}</a>
      </div>
      <div class="va-stats">
        {% for a in vm.alerts %}
          <div class="va-stat"><span class="va-stat__icon va-stat__icon--{{ a.tone }}">{{ ic.glyph(a.tone == 'danger' ? 'users' : (a.tone == 'warning' ? 'clock' : 'info'),18) }}</span><div class="va-stat__body"><strong class="va-stat__value">{{ a.count }}</strong><span class="va-stat__label">{{ a.title }}</span></div></div>
        {% endfor %}
      </div>
    </section>

    <section class="card va-panel">
      <div class="va-panel__head"><h2 class="va-panel__title">{{ ic.glyph('chart',20) }}<span>Consulta directiva</span></h2></div>
      <div class="va-quick">
        <a class="btn btn--secondary" href="{{ path('app_report_index') }}">{{ ic.glyph('chart',16) }}<span>Centro de reportes</span></a>
        <a class="btn btn--secondary" href="{{ path('app_report_progress_student') }}">{{ ic.glyph('trend',16) }}<span>Avance curricular</span></a>
        <a class="btn btn--secondary" href="{{ path('app_student_index') }}">{{ ic.glyph('users',16) }}<span>Directorio de alumnos</span></a>
        <a class="btn btn--secondary" href="{{ path('app_transcript_index') }}">{{ ic.glyph('file',16) }}<span>Expedientes</span></a>
      </div>
    </section>
  </div>
</div>
{% endblock %}
