<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Sistema Académico{% endblock %}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  {{ importmap('app') }}
</head>
<body>
  <a class="skip-link" href="#main">Saltar al contenido</a>
  <div class="app-shell">
    {% include 'components/_sidebar.html.twig' %}
    <div class="main">
      {% include 'components/_topbar.html.twig' %}
      <main id="main" class="content" tabindex="-1">
        {% include 'components/_breadcrumb.html.twig' with {crumbs: crumbs|default([])} %}
        {% for message in app.flashes('success') %}
          <div class="notice notice--success" role="status">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('danger') %}
          <div class="notice notice--danger" role="alert">{{ message }}</div>
        {% endfor %}
        {% block body %}{% endblock %}
      </main>
    </div>
  </div>
</body>
</html>
