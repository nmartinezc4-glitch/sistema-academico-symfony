{% set route = app.request.attributes.get('_route') %}

{% set items = [
  {label: 'Inicio', route: 'app_dashboard', icon: 'home'},

  {group: 'ESTUDIANTES', roleAny: ['ROLE_DOCENTE','ROLE_DIRECCION']},
  {label: 'Alumnos', route: 'app_student_index', match: 'app_student', icon: 'user', roleAny: ['ROLE_DOCENTE','ROLE_DIRECCION']},
  {label: 'Expedientes', route: 'app_transcript_index', match: 'app_transcript', icon: 'file', roleAny: ['ROLE_DOCENTE','ROLE_DIRECCION']},

  {group: 'ESTRUCTURA ACADÉMICA', roleAny: ['ROLE_COORDINACION','ROLE_DIRECCION']},
  {label: 'Carreras', route: 'app_career_index', icon: 'cap', roleAny: ['ROLE_COORDINACION','ROLE_DIRECCION']},
  {label: 'Cursos', route: 'app_course_index', icon: 'book', roleAny: ['ROLE_COORDINACION','ROLE_DIRECCION']},
  {label: 'Pensums', route: 'app_curriculum_index', match: 'app_curriculum', icon: 'layers', roleAny: ['ROLE_COORDINACION','ROLE_DIRECCION']},

  {group: 'GESTIÓN ACADÉMICA', roleAny: ['ROLE_COORDINACION','ROLE_DIRECCION']},
  {label: 'Años y períodos', route: 'app_period_index', match: 'app_period', icon: 'calendar', roleAny: ['ROLE_COORDINACION','ROLE_DIRECCION']},
  {label: 'Secciones', route: 'app_section_index', icon: 'users', roleAny: ['ROLE_COORDINACION','ROLE_DIRECCION']},
  {label: 'Ofertas', route: 'app_offering_index', match: 'app_offering', icon: 'bookmark', roleAny: ['ROLE_COORDINACION','ROLE_DIRECCION']},
  {label: 'Docentes y ofertas', route: 'app_teaching_assignment_index', match: 'app_teaching_assignment', icon: 'users', role: 'ROLE_COORDINACION'},

  {group: 'EVALUACIÓN', role: 'ROLE_DOCENTE'},
  {label: 'Ingreso de notas', route: 'app_grade_entry', match: 'app_grade', icon: 'pencil', role: 'ROLE_DOCENTE'},

  {group: 'ANÁLISIS', roleAny: ['ROLE_DOCENTE','ROLE_DIRECCION']},
  {label: 'Reportes', route: 'app_report_index', match: 'app_report', icon: 'chart', roleAny: ['ROLE_DOCENTE','ROLE_DIRECCION']},
  {label: 'Avance curricular', route: 'app_report_progress_student', icon: 'clock', roleAny: ['ROLE_DOCENTE','ROLE_DIRECCION']},

  {group: 'CONFIGURACIÓN', roleAny: ['ROLE_COORDINACION','ROLE_DIRECCION','ROLE_GESTION_USUARIOS']},
  {label: 'Políticas académicas', route: 'app_policy_index', match: 'app_policy', icon: 'gear', roleAny: ['ROLE_COORDINACION','ROLE_DIRECCION']},
  {label: 'Usuarios y roles', route: 'app_security_user_index', match: 'app_security_user', icon: 'users', role: 'ROLE_GESTION_USUARIOS'}
] %}

{% set icons = {
  home: '<path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/>',
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 5-5 8-5s6.5 1 8 5"/>',
  file: '<path d="M6 2h9l5 5v15H6z"/><path d="M14 2v6h6"/>',
  cap: '<path d="M12 4 2 9l10 5 10-5z"/><path d="M6 11v5c0 1.5 3 3 6 3s6-1.5 6-3v-5"/>',
  book: '<path d="M4 4h7a3 3 0 0 1 3 3v13a2 2 0 0 0-2-2H4z"/><path d="M20 4h-6"/>',
  layers: '<path d="m12 3 9 5-9 5-9-5z"/><path d="m3 13 9 5 9-5"/>',
  calendar: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/>',
  users: '<circle cx="9" cy="8" r="3.5"/><path d="M2 20c1-3.5 4-5 7-5s6 1.5 7 5"/><circle cx="17" cy="9" r="2.5"/>',
  bookmark: '<path d="M6 3h12v18l-6-4-6 4z"/>',
  pencil: '<path d="M4 20l4-1L20 7l-3-3L5 16z"/>',
  chart: '<path d="M4 20V10M10 20V4M16 20v-8M22 20H2"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/>',
  gear: '<circle cx="12" cy="12" r="3"/><path d="M19 12a7 7 0 0 0-.1-1.2l2-1.6-2-3.4-2.4 1a7 7 0 0 0-2-1.2L14 3h-4l-.5 2.6a7 7 0 0 0-2 1.2l-2.4-1-2 3.4 2 1.6A7 7 0 0 0 5 12c0 .4 0 .8.1 1.2l-2 1.6 2 3.4 2.4-1a7 7 0 0 0 2 1.2L10 21h4l.5-2.6a7 7 0 0 0 2-1.2l2.4 1 2-3.4-2-1.6c.07-.4.1-.8.1-1.2z"/>'
} %}

{% macro allowed(item) %}
  {# Macro kept intentionally empty: authorization is evaluated inline with is_granted(). #}
{% endmacro %}

<aside class="sidebar" id="sidebar" data-controller="sidebar" data-sidebar-open-value="false" aria-label="Navegación principal">
  <div class="sidebar__brand">
    <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 5c-2-1.5-5-2-8-2v15c3 0 6 .5 8 2 2-1.5 5-2 8-2V3c-3 0-6 .5-8 2z"/><path d="M12 5v15"/></svg>
    <span>SISTEMA<br>ACADÉMICO</span>
  </div>
  <nav>
    {% for item in items %}
      {% set allowed = item.role is not defined or is_granted(item.role) %}
      {% if allowed and item.roleAny is defined %}
        {% set allowed = false %}
        {% for requiredRole in item.roleAny %}
          {% if is_granted(requiredRole) %}{% set allowed = true %}{% endif %}
        {% endfor %}
      {% endif %}

      {% if allowed %}
        {% if item.group is defined %}
          <div class="sidebar__group">{{ item.group }}</div>
        {% else %}
          {% set active = item.match is defined ? route starts with item.match : route == item.route %}
          <a href="{{ path(item.route, item.params|default({})) }}" {% if active %}class="active" aria-current="page"{% endif %}>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">{{ icons[item.icon]|raw }}</svg>
            <span>{{ item.label }}</span>
          </a>
        {% endif %}
      {% endif %}
    {% endfor %}
  </nav>
  <div class="sidebar__footer" aria-hidden="true"></div>
</aside>
