<div class="student-header">
  <span class="avatar" aria-hidden="true">{{ vm.firstNames|slice(0,1) ~ vm.lastNames|slice(0,1) }}</span>
  <div>
    <div style="font-size:12px;color:var(--ink-muted)">{{ vm.code }}</div>
    <strong style="font-family:var(--font-display);font-size:20px">{{ vm.fullName }}</strong>
    <div style="color:var(--ink-soft);font-size:14px">{{ vm.career }} · {{ vm.curriculum }}{% if vm.currentPeriod %} · {{ vm.currentPeriod }}{% endif %}</div>
  </div>
  <div style="margin-left:auto">{% include 'components/_status_badge.html.twig' with {status: vm.status} %}</div>
</div>
